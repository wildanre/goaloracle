{
  "name": "goaloracle",
  "version": "0.1.0",
  "private": true,
  "description": "World Cup live data MCP server + x402 USDC micropayment API on Injective EVM",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "api": "tsx packages/api/src/server.ts",
    "mcp": "tsx packages/mcp-server/src/index.ts",
    "demo": "tsx scripts/demo.ts",
    "demo:client": "tsx scripts/demo-x402-client.ts",
    "cctp": "tsx scripts/fund-wallet-cctp.ts",
    "bundle:vercel": "esbuild packages/api/src/vercel.ts --bundle --platform=node --target=node20 --format=esm --outfile=api/index.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@goaloracle/api": "workspace:*",
    "@goaloracle/data": "workspace:*",
    "@injectivelabs/x402": "0.0.1",
    "viem": "^2.39.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0"
  }
}
