# --- Data ---
# football-data.org v4 API token (free tier). Optional: without it the bundled
# MockProvider serves realistic WC2026 fixture data so everything still works.
FOOTBALL_DATA_TOKEN=

# --- API ---
# HTTP port for packages/api (default 3000)
PORT=3000

# --- x402 / Injective EVM TESTNET (mainnet is refused by config) ---
# Address that receives premium-endpoint USDC payments.
# Optional: defaults to the facilitator wallet address.
PAY_TO_ADDRESS=
# Private key of the demo agent wallet that PAYS for premium calls
# (demo client + paid MCP tools). Holds trivial testnet USDC only.
AGENT_PRIVATE_KEY=
# Private key of the inline x402 facilitator wallet (settles payments on-chain,
# pays INJ gas — fund via https://testnet.faucet.injective.network).
# Optional: without it an ephemeral key is generated; 402 challenges still work
# but on-chain settlement will fail (dry/demo mode).
FACILITATOR_PRIVATE_KEY=
# Or use a remote facilitator service instead of the inline one:
X402_FACILITATOR_URL=
# Injective EVM testnet RPC (default: https://k8s.testnet.json-rpc.injective.network)
INJECTIVE_EVM_RPC=
# USDC (Circle FiatTokenV2_2) on Injective EVM testnet — get test USDC at https://faucet.circle.com
USDC_ADDRESS=0x0C382e685bbeeFE5d3d9C29e29E341fEE8E84C5d

# --- MCP server ---
# Base URL of the GoalOracle HTTP API the MCP tools call (default http://localhost:3000)
API_BASE_URL=

# --- CCTP funding script ---
# Ethereum Sepolia RPC for scripts/fund-wallet-cctp.ts (default: https://ethereum-sepolia-rpc.publicnode.com)
SEPOLIA_RPC=
